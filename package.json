{
  "name": "panda-smart-home",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "og": "node scripts/make-og.mjs",
    "photos": "node scripts/make-photos.mjs",
    "predev": "node scripts/copy-credits.mjs",
    "prebuild": "node scripts/copy-credits.mjs",
    "build:all": "npm run build && (cd showroom && npm ci && npm run build) && cp -R showroom/dist dist/showroom"
  },
  "dependencies": {
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7"
  }
}
