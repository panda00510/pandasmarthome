# ---------------------------------------------------------------------------
# Panda Smart Home — environment configuration
#
# Copy this file to `.env.local` (git-ignored) and fill in the real values.
# Every variable is OPTIONAL. Anything left blank is treated as "not yet
# configured": the site hides that contact channel, shows a neutral
# "Contact details to be confirmed" state, and omits the value from the
# JSON-LD structured data instead of publishing a placeholder.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets (API keys, tokens) in this file — it ships to the client.
# ---------------------------------------------------------------------------

# --- Company -----------------------------------------------------------------
# Registered / trading name. Defaults to "Panda Smart Home" when blank.
VITE_COMPANY_NAME=
VITE_COMPANY_NAME_ZH=
# e.g. a Singapore UEN. Rendered in the footer only when set.
VITE_COMPANY_REGISTRATION_NO=

# --- Contact channels ---------------------------------------------------------
# Blank = the channel is hidden everywhere (buttons, footer, structured data).
VITE_CONTACT_EMAIL=
# International format, e.g. +65 6000 0000
VITE_CONTACT_PHONE=
# Digits only, including country code, e.g. 6590000000
# The floating/inline WhatsApp buttons stay hidden until this is set.
VITE_WHATSAPP_NUMBER=

# --- Office address -----------------------------------------------------------
# Leave blank if there is no public walk-in address.
VITE_OFFICE_ADDRESS_STREET=
VITE_OFFICE_ADDRESS_LOCALITY=
VITE_OFFICE_ADDRESS_POSTAL_CODE=
VITE_OFFICE_ADDRESS_COUNTRY=SG

# --- Contact form -------------------------------------------------------------
# HTTPS endpoint that accepts a JSON POST of the enquiry form.
# Works with Formspree / Basin / Web3Forms / your own API route.
#
# How the form behaves:
#   endpoint set              -> posts JSON straight to it, no mail app involved
#   endpoint blank + email set-> opens the visitor's mail client, pre-filled and
#                                addressed to VITE_CONTACT_EMAIL
#   both blank                -> form is disabled with a visible notice; it will
#                                never fake a successful submission
#
# Web3Forms (no account, works on GitHub Pages):
#   VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
#   VITE_FORM_ACCESS_KEY=<the key they email you>
VITE_FORM_ENDPOINT=

# Public submission key sent as `access_key` in the payload. NOT a secret —
# it only routes mail to the address that registered it. Leave blank for
# endpoints that don't use one (Formspree, Basin, your own API route).
VITE_FORM_ACCESS_KEY=

# --- Site ----------------------------------------------------------------------
# Canonical origin without a trailing slash, e.g. https://pandasmarthome.sg
# Required for correct canonical, hreflang, og:url and sitemap URLs.
VITE_SITE_URL=

# --- Social profiles -----------------------------------------------------------
# Full profile URLs. Blank entries are omitted from the footer and from the
# `sameAs` array in the structured data.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_TELEGRAM=
VITE_SOCIAL_XIAOHONGSHU=
